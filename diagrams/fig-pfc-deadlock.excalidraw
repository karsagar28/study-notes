      "index": "ad",
      "roundness": null,
      "seed": 351094282,
      "version": 1,
      "versionNonce": 67111137,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788628638463,
      "link": null,
      "locked": false,
      "text": "Cyclic buffer dependency: each switch has paused the next \u2014 every buffer full, no one can drain, PFC has no timeout.",
      "fontSize": 12.0,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Cyclic buffer dependency: each switch has paused the next \u2014 every buffer full, no one can drain, PFC has no timeout.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "f39072b62f692795bb06",
      "type": "text",
      "x": 40.0,
      "y": 277.8,
      "width": 706.2,
      "height": 15.0,
      "angle": 0,
      "strokeColor": "#5C6470",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ae",
      "roundness": null,
      "seed": 1250160779,
      "version": 1,
      "versionNonce": 1835369339,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788628638463,
      "link": null,
      "locked": false,
      "text": "PFC watchdog: queue paused beyond threshold \u2192 stop honoring pause / drop on that queue, breaking the cycle.",
      "fontSize": 12.0,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "PFC watchdog: queue paused beyond threshold \u2192 stop honoring pause / drop on that queue, breaking the cycle.",
      "autoResize": true,
      "lineHeight": 1.25
    }
